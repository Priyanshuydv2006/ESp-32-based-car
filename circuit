  h1 { font-family: 'Orbitron', monospace; font-size: clamp(13px,2.5vw,20px); text-align: center; letter-spacing: 4px; color: var(--cyan); text-shadow: 0 0 18px var(--cyan); margin-bottom: 3px; }
