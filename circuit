  .wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 4px; background: var(--panel); padding: 8px; }
  .tables { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 14px; }
  table { flex: 1 1 240px; border: 1px solid var(--border); border-radius: 4px; overflow: hidden; font-size: 11px; border-collapse: collapse; }
  caption { font-family: 'Orbitron',monospace; font-size: 9px; letter-spacing: 2px; background: #0a1830; color: var(--cyan); padding: 6px 10px; text-align: left; }
  th { background: #0c1a30; color: var(--cyan-dim); padding: 4px 8px; font-weight: normal; border-bottom: 1px solid var(--border); }
  td { padding: 4px 8px; border-bottom: 1px solid #0c1825; color: var(--white); }
  tr:last-child td { border-bottom: none; }
  .p { color: var(--orange); font-weight: bold; }
  .s { color: var(--cyan); }
  .pw { color: var(--red); }
  .gn { color: var(--gray); }
  .mo { color: var(--yellow); }
  .notes { margin-top: 14px; border: 1px solid var(--border); border-radius: 4px; padding: 12px 14px; font-size: 11px; line-height: 1.8; color: var(--cyan-dim); }
  .notes b { color: var(--cyan); }
  .notes span { color: var(--orange); }
